+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS gip_device_physical_device_set_gain(struct unix_device *iface, BYTE percent)
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS gip_device_physical_effect_control(struct unix_device *iface, BYTE index,
+                                                   USAGE control, BYTE iterations)
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS gip_device_physical_effect_update(struct unix_device *iface, BYTE index,
+                                                  struct effect_params *params)
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+static const struct hid_device_vtbl gip_device_vtbl =
+{
+    gip_device_destroy,
+    gip_device_start,
+    iohid_device_stop,
+    gip_device_haptics_start,
+    gip_device_haptics_stop,
+    gip_device_physical_device_control,
+    gip_device_physical_device_set_gain,
+    gip_device_physical_effect_control,
+    gip_device_physical_effect_update,
 };
 
+static BOOL gip_build_report_descriptor(struct unix_device *iface)
+{
+    static const USAGE_AND_PAGE device_usage = {.UsagePage = HID_USAGE_PAGE_GENERIC, .Usage = HID_USAGE_GENERIC_GAMEPAD};
+
+    if (!hid_device_begin_report_descriptor(iface, &device_usage)) return FALSE;
+    if (!hid_device_add_gamepad(iface)) return FALSE;
+    if (!hid_device_end_report_descriptor(iface)) return FALSE;
+    return TRUE;
+}
+
 static void handle_DeviceMatchingCallback(void *context, IOReturn result, void *sender, IOHIDDeviceRef IOHIDDevice)
