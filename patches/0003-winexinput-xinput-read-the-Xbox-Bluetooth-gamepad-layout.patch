+/* The Xbox Wireless Controller over Bluetooth (and anything else reporting the
+ * same layout) puts its right stick on Z/Rz and its triggers on the Simulation
+ * page's Brake and Accelerator, and numbers its buttons with gaps: A=1, B=2,
+ * X=4, Y=5, LB=7, RB=8, View=11, Menu=12, LS=14, RS=15. Its Y axes grow
+ * downwards, as HID's do. Wine's SDL backend hides all of this by rewriting the
+ * report, but without SDL the raw device arrives here as it is. */
+static USAGE bt_layout_button(USAGE usage)
+{
+    switch (usage)
+    {
+    case 1: return 1;   /* A */
+    case 2: return 2;   /* B */
+    case 4: return 3;   /* X */
+    case 5: return 4;   /* Y */
+    case 7: return 5;   /* LB */
+    case 8: return 6;   /* RB */
+    case 11: return 7;  /* View */
+    case 12: return 8;  /* Menu */
+    case 14: return 9;  /* LS */
+    case 15: return 10; /* RS */
+    }
+    return 0;
+}
